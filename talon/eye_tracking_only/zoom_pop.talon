os: windows
-
key(f4): user.zoom_mouse_pop()
key(shift-f4): user.zoom_mouse_cancel()

# sent by the AutoHotkey mouse bridge while the zoom overlay is open
key(f13): user.zoom_mouse_commit_left()
key(f14): user.zoom_mouse_commit_right()
key(f15): user.zoom_mouse_cancel()
key(f16): user.zoom_mouse_commit_double()
key(f17): user.zoom_mouse_followup_click()
